# Developer-only ARM64 validation. Reuse the configured personal toolchain.
# Neither executable is copied into PortMaster-deploy packages.
include Makefile.portmaster

.PHONY: native-chip-validation
native-chip-validation: $(OBJECTS) tests/native_chip_ui.cpp tests/native_chip_audio.cpp
	$(CXX) $(CFLAGS) -Itests tests/native_chip_ui.cpp $(filter-out $(BUILD)/obj/platforms/shared/main.o,$(OBJECTS)) $(SDL_LIBS) $(MOD_LUCKY_LIBS) -lasound -pthread -lm -o $(BUILD)/native-chip-ui
	$(CXX) $(CFLAGS) -Itests tests/native_chip_audio.cpp $(filter-out $(BUILD)/obj/platforms/shared/main.o,$(OBJECTS)) $(SDL_LIBS) $(MOD_LUCKY_LIBS) -lasound -pthread -lm -o $(BUILD)/native-chip-audio
